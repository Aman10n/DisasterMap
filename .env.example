# ============================================
# DisasterMap Environment Configuration
# Copy to .env and customize before deployment
# ============================================

# --- Database (TimescaleDB + PostGIS) ---
POSTGRES_USER=disastermap
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=disastermap
DATABASE_URL=postgresql+asyncpg://disastermap:replace-with-a-strong-password@timescaledb:5432/disastermap

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MQTT Broker ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=disastermap-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=disastermap

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-random-secret-use-openssl-rand-hex-32
DEBUG=true

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Dashboard ---
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws
VITE_MQTT_WS_URL=ws://localhost:9001
